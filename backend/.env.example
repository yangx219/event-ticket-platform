# Copy this file to .env and fill in local values.
# Never commit backend/.env or paste real API keys into source code.

EVENTPILOT_AI_ENABLED=true
OPENAI_API_KEY=replace-with-your-own-key
OPENAI_MODEL=gpt-4.1-mini
AI_RATE_LIMIT_REQUESTS=5
AI_RATE_LIMIT_WINDOW=1m

# Optional local overrides. The defaults already match backend/docker-compose.yml.
